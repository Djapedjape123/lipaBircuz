{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*/index.html",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(o-kafani|cene|kontakt|najave|mali-fudbal|lipa-kviz|lipa-svuda|saradnje|dogadjaj|shop)",
      "destination": "/index.html"
    }
  ]
}
